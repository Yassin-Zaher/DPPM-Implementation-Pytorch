\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Statistical Analysis of the FID Discrepancy. \textbf  {Top:} Randomly sampled Real vs. Generated images show strong semantic alignment. \textbf  {Bottom:} The pixel intensity histograms reveal a "Variance Gap." Real images (Green) have high contrast/variance, while Generated images (Purple) are more concentrated. This variance drop ($\Sigma $) inflates the FID score.}}{18}{figure.caption.13}\protected@file@percent }
\newlabel{fig:fid_analysis}{{9}{18}{Statistical Analysis of the FID Discrepancy. \textbf {Top:} Randomly sampled Real vs. Generated images show strong semantic alignment. \textbf {Bottom:} The pixel intensity histograms reveal a "Variance Gap." Real images (Green) have high contrast/variance, while Generated images (Purple) are more concentrated. This variance drop ($\Sigma $) inflates the FID score}{figure.caption.13}{}}
