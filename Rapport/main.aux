\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Statistical Analysis of the FID Discrepancy. \textbf  {Top:} Randomly sampled Real vs. Generated images show strong semantic alignment (correct shapes/colors). \textbf  {Bottom:} The pixel intensity histograms reveal a "Variance Gap." Real images (Green) have high contrast/variance, while Generated images (Purple) are more concentrated, reflecting the texture smoothing inherent to diffusion models. This variance drop ($\Sigma $) inflates the FID score.}}{16}{figure.caption.12}\protected@file@percent }
\newlabel{fig:fid_analysis}{{9}{16}{Statistical Analysis of the FID Discrepancy. \textbf {Top:} Randomly sampled Real vs. Generated images show strong semantic alignment (correct shapes/colors). \textbf {Bottom:} The pixel intensity histograms reveal a "Variance Gap." Real images (Green) have high contrast/variance, while Generated images (Purple) are more concentrated, reflecting the texture smoothing inherent to diffusion models. This variance drop ($\Sigma $) inflates the FID score}{figure.caption.12}{}}
